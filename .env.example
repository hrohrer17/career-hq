# Copy this file to .env (in this folder or the folder above it) and fill in ONE key.
# Never commit the real .env.

# Course key: routes to gpt-6-luna through Portkey (preferred).
PORTKEY_API_KEY=

# Or a personal OpenAI key (used only if PORTKEY_API_KEY is empty; you pay for it).
OPENAI_API_KEY=

# Optional limits (defaults shown)
# CAREER_HQ_DAILY_BUDGET_USD=0.25
# CAREER_HQ_MAX_RUNS_PER_HOUR=20

# Optional: use a private database with real records instead of the demo data
# CAREER_HQ_DB=data/private/career_hq.sqlite3
